          <div-registration-steps active-step="5"></div-registration-steps>
        </qti-content-body>
      </qti-rubric-block>
      <qti-assessment-item-ref identifier="news" href="../../items/news.xml" />
    </qti-assessment-section>

    <qti-assessment-section identifier="feed" title="Feed" visible="true" keep-together="true">
      <qti-assessment-item-ref identifier="welcome-spacegram" href="../../items/welcome-spacegram.xml" category="info" />
      <qti-assessment-item-ref identifier="tangare" href="../../items/tangare.xml" />
      <qti-assessment-item-ref identifier="workflow" href="../../items/workflow.xml" />
      <qti-assessment-item-ref identifier="funny-video" href="../../items/funny-video.xml" />
      <qti-assessment-item-ref identifier="tie" href="../../items/tie.xml" />
