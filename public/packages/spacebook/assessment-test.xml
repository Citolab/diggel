<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-test
  xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0p1_v1p0.xsd"
  identifier="spacebook-demo"
  title="Spacebook demo"
>
  <qti-test-part identifier="part-1" navigation-mode="linear" submission-mode="individual">

    <qti-assessment-section identifier="registration" title="Registration" visible="true" keep-together="true">
      <qti-rubric-block use="instructions" view="candidate" class="qti-rubric-discretionary-placement">
        <qti-content-body>
          <div class="type:registration-steps" data-active-step="5"></div>
        </qti-content-body>
      </qti-rubric-block>
      <qti-assessment-item-ref identifier="news" href="../../items/news.xml" data-title="Follow news pages" data-author="Susan" />
    </qti-assessment-section>

    <qti-assessment-section identifier="welcome" title="Welcome" visible="true" keep-together="true">
      <qti-assessment-item-ref identifier="welcome-spacebook" href="../../items/welcome-spacebook.xml" category="info" data-title="Welcome" />
    </qti-assessment-section>

    <qti-assessment-section identifier="feed" title="Feed" visible="true" keep-together="true">
      <qti-assessment-item-ref identifier="tangare" href="../../items/tangare.xml" data-title="Bird from Brazil" data-author="Camil" />
      <qti-assessment-item-ref identifier="workflow" href="../../items/workflow.xml" data-title="Workflow tool" data-author="Tom" />
      <qti-assessment-item-ref identifier="funny-video" href="../../items/funny-video.xml" data-title="Funny video poll" data-author="Tom" />
      <qti-assessment-item-ref identifier="tie" href="../../items/tie.xml" data-title="Photo story — tie a knot" data-author="Susan" />
    </qti-assessment-section>

  </qti-test-part>
</qti-assessment-test>
